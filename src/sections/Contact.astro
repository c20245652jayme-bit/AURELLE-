<section class="contact" id="contact" aria-labelledby="contact-title">
	<div class="contact-copy">
		<p class="eyebrow"><span></span> Contact</p>
		<h2 id="contact-title">Let’s connect.</h2>
		<p>Have a question about network administration or one of the sample projects?</p>
	</div>
	<form class="contact-card contact-form" aria-label="Contact form">
		<span class="contact-label">SEND A MESSAGE</span>
		<label for="contact-name">Name</label>
		<input id="contact-name" name="name" type="text" autocomplete="name" required />
		<label for="contact-email">Email</label>
		<input id="contact-email" name="email" type="email" autocomplete="email" required />
		<label for="contact-message">Message</label>
		<textarea id="contact-message" name="message" rows="4" required></textarea>
		<button type="submit" disabled>Send message</button>
		<p class="contact-note">Email delivery will be enabled once a recipient address is configured.</p>
	</form>
</section>

<style>
	.contact { display: grid; grid-template-columns: 1fr minmax(280px, .8fr); align-items: center; gap: 56px; padding: 66px max(32px, calc((100% - 1256px) / 2)); border-top: 1px solid var(--line); background: var(--surface); color: var(--ink); }
	.eyebrow { display: flex; align-items: center; gap: 9px; margin: 0 0 18px; font-size: 11px; font-weight: 800; letter-spacing: .16em; text-transform: uppercase; }
	.eyebrow span { width: 7px; height: 7px; border-radius: 50%; background: var(--accent-soft); }
	h2 { margin: 0; font-family: var(--font-display); font-size: clamp(44px, 5vw, 68px); font-weight: 400; letter-spacing: -.055em; line-height: .98; }
	.contact-copy > p:last-child { max-width: 460px; margin: 18px 0 0; color: var(--muted); font-size: 15px; line-height: 1.7; }
	.contact-card { padding: 0; border: 0; background: transparent; }
	.contact-label { display: block; margin-bottom: 20px; color: var(--accent-strong); font-size: 9px; font-weight: 700; letter-spacing: .14em; }
	.contact-form { display: grid; gap: 8px; }
	.contact-form label { margin-top: 6px; color: var(--ink); font-size: 11px; font-weight: 600; }
	.contact-form input, .contact-form textarea { width: 100%; padding: 9px 0; border: 0; border-bottom: 1px solid #d4d0d6; border-radius: 0; background: transparent; color: var(--ink); }
	.contact-form textarea { min-height: 88px; resize: vertical; }
	.contact-form input:focus-visible, .contact-form textarea:focus-visible { outline-color: var(--accent-strong); }
	.contact-form button { justify-self: start; margin-top: 10px; padding: 8px 0; border: 0; border-bottom: 1px solid var(--accent-strong); background: transparent; color: var(--ink); font-size: 12px; font-weight: 700; cursor: pointer; }
	.contact-form button:disabled { opacity: .55; cursor: not-allowed; }
	.contact-note { margin: 4px 0 0; color: var(--muted); font-size: 11px; line-height: 1.6; }
	@media (max-width: 700px) {
		.contact { grid-template-columns: 1fr; gap: 30px; padding: 70px 20px; }
	}
</style>