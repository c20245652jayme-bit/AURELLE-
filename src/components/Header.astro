---
import BrandLogo from "./BrandLogo.astro";
---

<header class="nav-wrap">
	<nav class="nav" aria-label="Main navigation">
		<BrandLogo />
		<div class="nav-links">
			<a class="mobile-hide" href="/#top">Home</a>
			<a class="mobile-hide" href="/#services">Services</a>
			<a class="mobile-hide" href="/#process">Process</a>
			<a href="/#about">About</a>
			<a href="/#projects">Projects</a>
			<a href="/#contact">Contact</a>
		</div>
	</nav>
</header>

<style>
	.nav-wrap {
		height: 76px;
		border-bottom: 1px solid var(--line);
		background: rgba(255,255,255,.96);
	}
	.nav {
		max-width: 1320px;
		height: 100%;
		margin: 0 auto;
		padding: 0 32px;
		display: flex;
		align-items: center;
		justify-content: space-between;
	}
	.nav-links {
		display: flex;
		align-items: center;
		gap: 22px;
		font-size: 12px;
		color: var(--muted);
	}
	.nav-links a {
		text-decoration: none;
		transition: color .18s ease;
	}
	.nav-links a:hover {
		color: var(--ink);
	}
	@media (max-width: 620px) {
		.nav-wrap { height: 66px; }
		.nav { padding: 0 16px; }
		.nav-links { gap: 12px; font-size: 11px; }
		.mobile-hide { display: none; }
	}
</style>
