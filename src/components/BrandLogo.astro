---
interface Props {
	href?: string;
	tagline?: string;
}

const { href = "/", tagline = "NETWORK ADMIN" } = Astro.props;
---

<a class="brand" href={href} aria-label="N/A home">
	<img src="/na-logo.png" alt="" width="56" height="56" />
	<span class="brand-copy" aria-hidden="true">
		<span class="brand-name">N/A</span>
		<span class="brand-tagline">{tagline}</span>
	</span>
</a>

<style>
	.brand {
		display: flex;
		align-items: center;
		gap: 12px;
		color: var(--ink);
		text-decoration: none;
	}
	.brand img { display: block; width: 52px; height: 52px; flex: 0 0 auto; object-fit: contain; }
	.brand-copy { display: grid; gap: 3px; }
	.brand-name { font-family: var(--font-display); font-size: 23px; letter-spacing: .16em; line-height: 1; }
	.brand-tagline { color: var(--muted); font-size: 8px; font-weight: 700; letter-spacing: .22em; }
	@media (max-width: 620px) {
		.brand { gap: 8px; }
		.brand img { width: 42px; height: 42px; }
		.brand-name { font-size: 18px; letter-spacing: .13em; }
		.brand-tagline { font-size: 7px; }
	}
</style>
